# DAYDAY Management System - Environment Variables
# Copy this file to .env.local and update with your Supabase credentials

# ==============================================================================
# BROWSER ACCESSIBLE VARIABLES (Exposed to client)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_NAME="DAYDAY Management System"
NEXT_PUBLIC_COMPANY_NAME="DAYDAY SPARKLE AND SHINE CLEANING SERVICE"
NEXT_PUBLIC_COMPANY_TAGLINE="Satisfaction Guaranteed."
NEXT_PUBLIC_DEFAULT_CURRENCY="GH₵"
NEXT_PUBLIC_TIMEZONE="Africa/Accra"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# SERVER-ONLY VARIABLES (NEVER EXPOSE TO CLIENT)
# ==============================================================================
# Privileged service role key for admin user provisioning and backend tasks
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Email & WhatsApp gateway integrations (Paystack, Twilio / Arkesel / Hubtel)
PAYSTACK_SECRET_KEY=
ARKESEL_SMS_API_KEY=
